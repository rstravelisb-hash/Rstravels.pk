# RS Travel and Tours - Environment Variables Template
# ----------------------------------------------------
# IMPORTANT SECURITY NOTICE:
# Any variable prefixed with `VITE_` will be exposed to the client-side JavaScript bundle!
# NEVER put private API secrets, database passwords, private encryption keys,
# or administrative tokens into VITE_ variables or commit them to source control.

# Site Configuration
VITE_SITE_URL=https://rstravel.pk
VITE_SITE_NAME="RS Travel and Tours"

# Optional Client-Side Analytics (Public Tracking IDs only)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_META_PIXEL_ID=XXXXXXXXXXXXXXX

# Build & CI/CD Scripts (Node.js runtime only - NEVER exposed to frontend)
# INDEXNOW_KEY=your_indexnow_key_here
