{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.rstravel.pk"
        }
      ],
      "destination": "https://rstravel.pk/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rstravels.pk"
        }
      ],
      "destination": "https://rstravel.pk/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.rstravels.pk"
        }
      ],
      "destination": "https://rstravel.pk/:path*",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/visa-services",
      "permanent": true
    },
    {
      "source": "/services/:path*",
      "destination": "/visa-services",
      "permanent": true
    },
    {
      "source": "/visa",
      "destination": "/visa-services",
      "permanent": true
    },
    {
      "source": "/flights",
      "destination": "/air-ticketing",
      "permanent": true
    },
    {
      "source": "/hotels",
      "destination": "/hotel-booking",
      "permanent": true
    },
    {
      "source": "/insurance",
      "destination": "/travel-insurance",
      "permanent": true
    },
    {
      "source": "/passport",
      "destination": "/passport-services",
      "permanent": true
    },
    {
      "source": "/assessment",
      "destination": "/profile-assessment",
      "permanent": true
    },
    {
      "source": "/reviews",
      "destination": "/testimonials",
      "permanent": true
    },
    {
      "source": "/faqs",
      "destination": "/faq",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
